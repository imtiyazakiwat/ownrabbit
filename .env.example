# ---------------------------------------------------------------- web (apps/web, Vercel)
APP_URL=https://your-app.vercel.app

# From scripts/create-github-app.mjs output (.secrets/github-app.json)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=          # PEM; literal \n sequences are accepted
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

SESSION_SECRET=                  # openssl rand -base64 48

GCP_PROJECT=
TASKS_LOCATION=us-central1
TASKS_QUEUE=ownrabbit-reviews
WORKER_URL=https://ownrabbit-worker-xxxx.a.run.app
TASKS_INVOKER_EMAIL=ownrabbit-invoker@PROJECT.iam.gserviceaccount.com

# base64 of the `web` service account JSON key (Firestore + Cloud Tasks enqueue)
FIREBASE_SERVICE_ACCOUNT=
GCP_SERVICE_ACCOUNT=

# ---------------------------------------------------------------- worker (apps/worker, Cloud Run)
# GOOGLE_CLOUD_PROJECT=
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=        # mount from Secret Manager
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=                   # mount from Secret Manager
# TASKS_AUDIENCE=                # the worker's own URL
# TASKS_INVOKER_EMAIL=
# WORKER_AUTH_DISABLED=1         # local dev only; ignored when NODE_ENV=production
